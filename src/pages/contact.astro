---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import { SITE } from "../consts";

const reasons = [
  { label: "Partnerships", subject: "Partnership inquiry" },
  { label: "Careers", subject: "Joining EvoQuake" },
  { label: "Press", subject: "Press inquiry" },
  { label: "Anything else", subject: "Hello EvoQuake" },
];

const mailto = (subject: string) =>
  `mailto:${SITE.email}?subject=${encodeURIComponent(subject)}`;
---

<Layout title="Contact" description="Get in touch with EvoQuake.">
  <Section
    eyebrow="Contact"
    title="Let's talk"
    lead="Building with agents, exploring a partnership, or just curious what we're up to? We'd love to hear from you."
  >
    <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr]">
      <div class="card">
        <p class="text-sm text-[var(--color-faint)]">Email us directly</p>
        <a
          href={mailto("Hello EvoQuake")}
          class="mt-1 block break-all font-mono text-xl text-[var(--color-accent)] hover:underline"
        >
          {SITE.email}
        </a>

        <p class="mt-8 text-sm text-[var(--color-faint)]">Or pick a topic</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {
            reasons.map((r) => (
              <a href={mailto(r.subject)} class="btn-ghost">
                {r.label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="card flex flex-col justify-center">
        <p class="text-[var(--color-muted)]">
          We read every message. For the fastest response, tell us who you are
          and what you're hoping to do — the more specific, the better.
        </p>
        <a href={mailto("Hello EvoQuake")} class="btn-primary mt-6 self-start">
          Compose an email →
        </a>
      </div>
    </div>
  </Section>
</Layout>
