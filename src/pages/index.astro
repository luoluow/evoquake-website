---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import { SITE } from "../consts";

const makes = [
  {
    icon: "◇",
    title: "Speak a new language — with a partner who listens",
    html: `Free courses that teach you to hear and say the language, not just read it: <a href="https://kuyun.evoquake.com/p/p_a8fa45a4c3" class="text-(--color-accent) hover:underline">Spanish</a>, <a href="https://kuyun.evoquake.com/p/p_d3185f469f" class="text-(--color-accent) hover:underline">French</a>, <a href="https://kuyun.evoquake.com/p/p_350968a0fa" class="text-(--color-accent) hover:underline">Chinese</a>, <a href="https://kuyun.evoquake.com/p/p_65adef2443" class="text-(--color-accent) hover:underline">Japanese</a>, <a href="https://kuyun.evoquake.com/p/p_cf8e3f9e81" class="text-(--color-accent) hover:underline">English</a>. Each lesson is a story with the lines spoken aloud; you say them back and your study partner tells you how it sounded, then checks your blanks and quizzes.`,
    more: `<a href="https://kuyun.evoquake.com/app/#/explore?q=language%20course" class="text-(--color-accent) hover:underline">All language courses →</a>`,
  },
  {
    icon: "◷",
    title: "Hear the classics, free",
    html: `A growing shelf of audiobooks read chapter by chapter, with a reading companion that answers your questions and keeps the spoilers: <a href="https://kuyun.evoquake.com/p/p_f0d900bb17" class="text-(--color-accent) hover:underline">The Importance of Being Earnest</a>, <a href="https://kuyun.evoquake.com/p/p_88a3105888" class="text-(--color-accent) hover:underline">Dr Jekyll and Mr Hyde</a>, <a href="https://kuyun.evoquake.com/p/p_a90c9501f8" class="text-(--color-accent) hover:underline">The Great Gatsby</a>, <a href="https://kuyun.evoquake.com/p/p_1d5ba966d2" class="text-(--color-accent) hover:underline">The Secret Garden</a>, <a href="https://kuyun.evoquake.com/p/p_4fb8b9113a" class="text-(--color-accent) hover:underline">The Time Machine</a>, <a href="https://kuyun.evoquake.com/p/p_ae53a55125" class="text-(--color-accent) hover:underline">Alice in Wonderland</a>, <a href="https://kuyun.evoquake.com/p/p_5b7de26d31" class="text-(--color-accent) hover:underline">bedtime stories</a>. New titles land every day, in English, Spanish, French, Chinese and more.`,
    more: `<a href="https://kuyun.evoquake.com/app/#/explore?q=read%20aloud" class="text-(--color-accent) hover:underline">Browse the shelf →</a>`,
  },
  {
    icon: "⌁",
    title: "Understand the research — longevity, medicine, AI",
    html: `Ask a real question and Kuyun reads the papers and writes you a report where every claim has its source: <a href="https://kuyun.evoquake.com/p/p_f6dacf61b6" class="text-(--color-accent) hover:underline">can an aging clock be a clinical endpoint?</a>, <a href="https://kuyun.evoquake.com/p/p_475caa44fd" class="text-(--color-accent) hover:underline">rejuvenation without cancer</a>, <a href="https://kuyun.evoquake.com/p/p_b3603d5d58" class="text-(--color-accent) hover:underline">does microbiome-based nutrition work?</a>, <a href="https://kuyun.evoquake.com/p/p_fdc3d695cf" class="text-(--color-accent) hover:underline">how well does pathology AI travel?</a>, <a href="https://kuyun.evoquake.com/p/p_28e27d2bf1" class="text-(--color-accent) hover:underline">memory for long-horizon agents</a>, <a href="https://kuyun.evoquake.com/p/p_009c0ad0d8" class="text-(--color-accent) hover:underline">verifying LLM tool calls</a>. Then ask the report itself anything.`,
    more: `<a href="https://kuyun.evoquake.com/app/#/explore?q=research" class="text-(--color-accent) hover:underline">More research →</a>`,
  },
  {
    icon: "◎",
    title: "Stay ahead — a briefing every morning",
    html: `Say what you follow and Kuyun looks it up afresh at your hour and hands you the day's digest with its sources — <a href="https://kuyun.evoquake.com/p/p_792788f231" class="text-(--color-accent) hover:underline">the morning in AI</a>, <a href="https://kuyun.evoquake.com/p/p_eb4ce3e2bf" class="text-(--color-accent) hover:underline">the US markets</a>, flight deals to Hawaii, the research on a subject you care about. It lands in your Home chat; nothing to open, nothing to search.`,
    more: `<a href="https://kuyun.evoquake.com/app/#/explore?q=briefing" class="text-(--color-accent) hover:underline">See a briefing →</a>`,
  },
];

const facts = [
  { value: "Shows its work", label: "Every answer has a why you can open" },
  { value: "Free every day", label: "An allowance that comes back each morning" },
  { value: "Yours to shape", label: "Remembers you; see and edit what it believes" },
];

const layers = [
  {
    title: "Agent runtime",
    body: "Long-running projects with a goal, a brief and a plan: memory, tools and orchestration that keep working between a person's visits.",
  },
  {
    title: "Reliability & guardrails",
    body: "A separate reviewer judges every step, every action is in an inspectable record, and nothing reaches the world without the person.",
  },
  {
    title: "Everyday interfaces",
    body: "A conversation, a page of files beside it, and a companion for whoever receives the work — no prompts to learn.",
  },
];
---

<Layout>
  <!-- Hero -->
  <section class="container-x pt-20 pb-16 sm:pt-28">
    <p class="eyebrow mb-5">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-(--color-accent)"
      ></span>
      {SITE.legalName}
    </p>
    <h1
      class="max-w-3xl text-4xl font-semibold leading-[1.1] tracking-tight sm:text-6xl"
    >
      Frontier AI for everyone:
      <span class="text-gradient">Kuyun AI</span>.
    </h1>
    <p class="mt-6 max-w-xl text-lg text-(--color-muted)">
      Say what you want to learn, make or follow, and Kuyun builds it while
      you are away — a course with a study partner for every learner, a book
      read aloud, a library with a librarian, a briefing every morning. It
      shows its work, it is shaped by you, and there is a free allowance
      every day.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={SITE.kuyunSignup} class="btn-primary">Try Kuyun free</a>
      <a href="/product" class="btn-ghost">What it does</a>
      <a href={SITE.kuyunDemo} class="btn-ghost">Watch the one-minute demo</a>
    </div>

    <dl class="mt-16 grid gap-px overflow-hidden rounded-xl border border-(--color-border) bg-(--color-border) sm:grid-cols-3">
      {
        facts.map((s) => (
          <div class="bg-(--color-surface) p-6">
            <dt class="font-mono text-lg text-(--color-fg)">{s.value}</dt>
            <dd class="mt-1 text-sm text-(--color-faint)">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- What people make -->
  <Section
    eyebrow="What will you learn today?"
    title="Real things people are learning on Kuyun right now"
    lead="Every link below is a published work you can open. Each comes with a companion of its own — a study partner, a reading companion, a report you can question."
  >
    <div class="grid gap-5 sm:grid-cols-2">
      {
        makes.map((p) => (
          <div class="card">
            <div
              class="grid h-10 w-10 place-items-center rounded-lg bg-(--color-accent-dim) text-lg text-(--color-accent)"
              aria-hidden="true"
            >
              {p.icon}
            </div>
            <h3 class="mt-4 font-semibold">{p.title}</h3>
            <p class="mt-2 text-sm text-(--color-muted)" set:html={p.html} />
            <p class="mt-3 text-sm font-medium" set:html={p.more} />
          </div>
        ))
      }
    </div>
    <p class="mt-8 max-w-2xl text-(--color-muted)">
      Publish a work with a cover and it is on <strong class="text-(--color-fg)">Explore</strong>
      for anyone to find — by topic, by maker or by language — and it earns you
      credit as people use it. Kuyun speaks English, 中文 and Español.
    </p>
  </Section>

  <!-- Under the hood -->
  <Section
    eyebrow="Under the hood"
    title="Infrastructure built for agents that earn trust"
    lead="Kuyun runs on the platform EvoQuake builds: a runtime for long-running agents, a control layer that keeps them honest, and surfaces made for people."
  >
    <div class="grid gap-5 sm:grid-cols-3">
      {
        layers.map((l) => (
          <div class="card">
            <h3 class="font-semibold">{l.title}</h3>
            <p class="mt-2 text-sm text-(--color-muted)">{l.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Thesis CTA -->
  <Section>
    <div
      class="relative overflow-hidden rounded-2xl border border-(--color-border) bg-(--color-surface) p-8 sm:p-12"
    >
      <p class="eyebrow mb-4">Our thesis</p>
      <p class="max-w-3xl text-xl font-medium leading-snug sm:text-2xl">
        The newest AI should not require blind faith. A capable agent that
        works on your behalf has to explain every answer, keep a record you
        can inspect, and be shaped by you — not the other way around. Kuyun is
        that agent, and the infrastructure under it is what we build.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={SITE.kuyunUrl} class="btn-primary">Open Kuyun</a>
        <a href="/about" class="btn-ghost">Why EvoQuake</a>
        <a href={`mailto:${SITE.email}`} class="btn-ghost">Work with us</a>
      </div>
    </div>
  </Section>
</Layout>
