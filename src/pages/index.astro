---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import { SITE } from "../consts";

const pillars = [
  {
    icon: "◇",
    title: "Agent runtime",
    body: "A dependable runtime for long-running agents — memory, tools, and orchestration that hold up outside the demo.",
  },
  {
    icon: "◷",
    title: "Reliability & guardrails",
    body: "Evaluation, observability, and guardrails so agents stay correct, predictable, and safe to trust with real tasks.",
  },
  {
    icon: "⌁",
    title: "Everyday interfaces",
    body: "Human-first surfaces that bring agentic capability into daily life without asking people to think like engineers.",
  },
];

const stats = [
  { value: "Agent-native", label: "Built for autonomy, not bolted on" },
  { value: "Open by design", label: "Composable, inspectable infrastructure" },
  { value: "Human-first", label: "Capability people actually feel" },
];
---

<Layout>
  <!-- Hero -->
  <section class="container-x pt-20 pb-16 sm:pt-28">
    <p class="eyebrow mb-5">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-[--color-accent]"
      ></span>
      {SITE.legalName}
    </p>
    <h1
      class="max-w-3xl text-4xl font-semibold leading-[1.1] tracking-tight sm:text-6xl"
    >
      AI & agentic infrastructure to
      <span class="text-gradient">empower everyday life</span>.
    </h1>
    <p class="mt-6 max-w-xl text-lg text-[--color-muted]">
      {SITE.description}
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="/contact" class="btn-ghost">Get in touch</a>
      <a href="/product" class="btn-ghost">Explore the platform</a>
    </div>

    <dl class="mt-16 grid gap-px overflow-hidden rounded-xl border border-[--color-border] bg-[--color-border] sm:grid-cols-3">
      {
        stats.map((s) => (
          <div class="bg-[--color-surface] p-6">
            <dt class="font-mono text-lg text-[--color-fg]">{s.value}</dt>
            <dd class="mt-1 text-sm text-[--color-faint]">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Pillars -->
  <Section
    eyebrow="What we build"
    title="Infrastructure for agents that earn trust"
    lead="The hard part of agents isn't the demo — it's making them reliable, observable, and genuinely useful day after day. That's what we build."
  >
    <div class="grid gap-5 sm:grid-cols-3">
      {
        pillars.map((p) => (
          <div class="card">
            <div
              class="grid h-10 w-10 place-items-center rounded-lg bg-[--color-accent-dim] text-lg text-[--color-accent]"
              aria-hidden="true"
            >
              {p.icon}
            </div>
            <h3 class="mt-4 font-semibold">{p.title}</h3>
            <p class="mt-2 text-sm text-[--color-muted]">{p.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Thesis CTA -->
  <Section>
    <div
      class="relative overflow-hidden rounded-2xl border border-[--color-border] bg-[--color-surface] p-8 sm:p-12"
    >
      <p class="eyebrow mb-4">Our thesis</p>
      <p class="max-w-3xl text-xl font-medium leading-snug sm:text-2xl">
        The next platform shift isn't another app — it's capable agents working
        on your behalf. Getting there needs infrastructure built for autonomy
        from the ground up. We're building it.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/about" class="btn-ghost">Why EvoQuake</a>
        <a href={`mailto:${SITE.email}`} class="btn-ghost">Work with us</a>
      </div>
    </div>
  </Section>
</Layout>
