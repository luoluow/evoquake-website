---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import { SITE, KUYUN } from "../consts";

const pillars = [
  {
    icon: "◇",
    title: "It remembers you",
    body: "Tell it once. Your preferences, projects, and context carry across every conversation — no re-explaining yourself.",
  },
  {
    icon: "◷",
    title: "It explains itself",
    body: "Every answer comes with its reasoning, and every action leaves an inspectable record. You can always see why it did what it did.",
  },
  {
    icon: "⌁",
    title: "You're in control",
    body: "See everything Kuyun knows about you, edit it, or delete it for good — conversations, memories, and your account included.",
  },
];

const stats = [
  { value: "Frontier models", label: "The best AI available, for everyone" },
  { value: "Yours to shape", label: "Feedback changes how it behaves — permanently" },
  { value: "Nothing hidden", label: "Inspect, edit, or erase what it knows" },
];

const waitlist = `mailto:${SITE.email}?subject=${encodeURIComponent("Join the Kuyun beta")}`;
---

<Layout>
  <!-- Hero -->
  <section class="container-x pt-20 pb-16 sm:pt-28">
    <p class="eyebrow mb-5">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-[--color-accent]"
      ></span>
      {SITE.legalName} · {KUYUN.name} — {KUYUN.status}
    </p>
    <h1
      class="max-w-3xl text-4xl font-semibold leading-[1.1] tracking-tight sm:text-6xl"
    >
      Frontier AI for
      <span class="text-gradient">everyone</span>.
    </h1>
    <p class="mt-6 max-w-xl text-lg text-[--color-muted]">
      Meet {KUYUN.name}: a personal AI assistant that remembers you, explains
      itself, and never keeps anything about you that you can't see, change, or
      delete.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={KUYUN.url} class="btn-primary">Open {KUYUN.name} →</a>
      <a href={waitlist} class="btn-ghost">Join the beta</a>
    </div>

    <dl class="mt-16 grid gap-px overflow-hidden rounded-xl border border-[--color-border] bg-[--color-border] sm:grid-cols-3">
      {
        stats.map((s) => (
          <div class="bg-[--color-surface] p-6">
            <dt class="font-mono text-lg text-[--color-fg]">{s.value}</dt>
            <dd class="mt-1 text-sm text-[--color-faint]">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Pillars -->
  <Section
    eyebrow="Why Kuyun"
    title="An assistant that's actually yours"
    lead="Most AI assistants treat every conversation as a stranger and every decision as a black box. Kuyun is built the other way around."
  >
    <div class="grid gap-5 sm:grid-cols-3">
      {
        pillars.map((p) => (
          <div class="card">
            <div
              class="grid h-10 w-10 place-items-center rounded-lg bg-[--color-accent-dim] text-lg text-[--color-accent]"
              aria-hidden="true"
            >
              {p.icon}
            </div>
            <h3 class="mt-4 font-semibold">{p.title}</h3>
            <p class="mt-2 text-sm text-[--color-muted]">{p.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Thesis CTA -->
  <Section>
    <div
      class="relative overflow-hidden rounded-2xl border border-[--color-border] bg-[--color-surface] p-8 sm:p-12"
    >
      <p class="eyebrow mb-4">Our thesis</p>
      <p class="max-w-3xl text-xl font-medium leading-snug sm:text-2xl">
        The most capable AI in the world shouldn't be reserved for experts, and
        it shouldn't be a black box. Everyone deserves an assistant that knows
        them, shows its work, and answers to them — not the other way around.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/product" class="btn-ghost">Explore {KUYUN.name}</a>
        <a href="/about" class="btn-ghost">Why EvoQuake</a>
      </div>
    </div>
  </Section>
</Layout>
