---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import { SITE, KUYUN } from "../consts";

const features = [
  {
    name: "Memory",
    tag: "Continuity",
    body: "Tell it once. Preferences, projects, and context carry across every conversation, so Kuyun picks up where you left off instead of starting from zero.",
    points: ["Remembers what matters to you", "Context carries across chats", "No re-explaining yourself"],
  },
  {
    name: "Adaptability",
    tag: "Yours to shape",
    body: "Ask for a change — “be more direct”, “keep answers short” — and it sticks. Your feedback shapes how Kuyun behaves, and you can even propose new abilities.",
    points: ["Behavior changes persist", "Feedback shapes the assistant", "Propose new abilities"],
  },
  {
    name: "Transparency",
    tag: "Trust",
    body: "Kuyun explains its answers and keeps an inspectable record of its actions. It can even read its own source to tell you exactly how it works.",
    points: ["Reasoning behind every answer", "Inspectable action log", "Explains its own internals"],
  },
  {
    name: "Control",
    tag: "Your data",
    body: "The “What Kuyun knows” page shows everything it has learned about you. Edit it, or delete it — conversations, memories, and your account — completely.",
    points: ["See everything it knows", "Edit any memory", "True, complete deletion"],
  },
];

const waitlist = `mailto:${SITE.email}?subject=${encodeURIComponent("Join the Kuyun beta")}`;
---

<Layout title="Kuyun" description="Kuyun is EvoQuake's personal AI assistant: frontier AI that remembers you, explains itself, and keeps you in control of your data.">
  <Section
    eyebrow={`${KUYUN.name} · ${KUYUN.status}`}
    title="Frontier AI that works for you — and only you"
    lead="Kuyun is a personal AI assistant built on transparency and user control. It remembers, adapts, explains itself, and lets you see and erase everything it knows."
  >
    <div class="mb-10 flex flex-wrap gap-3">
      <a href={KUYUN.url} class="btn-primary">Open {KUYUN.name} →</a>
      <a href={waitlist} class="btn-ghost">Join the beta</a>
    </div>
    <div class="space-y-4">
      {
        features.map((f, i) => (
          <article class="card sm:flex sm:items-start sm:gap-8">
            <div class="flex items-center gap-4 sm:w-48 sm:shrink-0">
              <span class="font-mono text-sm text-[--color-faint]">
                0{i + 1}
              </span>
              <div>
                <h3 class="text-lg font-semibold">{f.name}</h3>
                <span class="eyebrow">{f.tag}</span>
              </div>
            </div>
            <div class="mt-4 sm:mt-0">
              <p class="text-[--color-muted]">{f.body}</p>
              <ul class="mt-4 grid gap-2 sm:grid-cols-3">
                {f.points.map((p) => (
                  <li class="flex items-start gap-2 text-sm">
                    <span class="mt-1 text-[--color-accent]" aria-hidden="true">
                      ▸
                    </span>
                    <span class="text-[--color-fg]">{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <Section>
    <div
      class="rounded-2xl border border-[--color-border] bg-[--color-surface] p-8 text-center sm:p-12"
    >
      <h2 class="text-2xl font-semibold tracking-tight">
        {KUYUN.name} is in private beta.
      </h2>
      <p class="mx-auto mt-3 max-w-md text-[--color-muted]">
        We're inviting people in gradually. Tell us a little about yourself and
        how you'd use it, and we'll be in touch.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href={waitlist} class="btn-primary">Request an invite →</a>
        <a href={KUYUN.url} class="btn-ghost">Already have access? Open {KUYUN.name}</a>
      </div>
    </div>
  </Section>
</Layout>
