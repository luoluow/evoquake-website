---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import { SITE } from "../consts";

const values = [
  {
    title: "For everyone, not just experts",
    body: "Frontier AI should be as easy to use as asking a question. No prompts to learn, no settings to master.",
  },
  {
    title: "Empower, don't replace",
    body: "AI should expand what a person can do — not quietly take the wheel. People stay in control, always.",
  },
  {
    title: "Nothing hidden",
    body: "Trust comes from being able to look inside. Kuyun shows its reasoning, its actions, and everything it knows about you.",
  },
];
---

<Layout title="About" description="EvoQuake is on a mission to bring frontier AI to everyone — starting with Kuyun, a personal assistant you can trust.">
  <Section
    eyebrow="About"
    title="Bringing frontier AI to everyone"
    lead="EvoQuake CO. was founded by Michael Luo to put the most capable AI in the world in everyone's hands — in a form they can understand, shape, and trust."
  >
    <div class="prose-invert max-w-2xl space-y-4 text-(--color-muted)">
      <p>
        AI has crossed a threshold: frontier models can now reason, remember,
        and act. But most people meet that capability through assistants that
        forget them every session, can't say why they did something, and keep
        what they've learned out of sight.
      </p>
      <p>
        So we build the layer between frontier models and the
        moments where they actually help someone get through their day — and
        <a href="/product" class="text-(--color-accent)">Kuyun AI</a> is where
        people meet it: courses, books, libraries and briefings made for them,
        shown with their work, free every day.
      </p>
    </div>
  </Section>

  <Section eyebrow="Founder" title="Michael Luo">
    <div class="card max-w-2xl">
      <div class="space-y-4 text-(--color-muted)">
        <p>
          Michael founded EvoQuake after more than 15 years building the
          serving, data, and machine-learning infrastructure behind some of the
          world's largest recommendation systems. He's led engineering teams at
          Meta, Google, and Microsoft — the through-line being large, complex ML
          systems that have to stay fast, correct, and affordable at scale.
        </p>
      </div>
      <dl
        class="mt-6 grid gap-x-6 gap-y-3 border-t border-(--color-border) pt-6 text-sm sm:grid-cols-2"
      >
        <div>
          <dt class="font-mono text-xs text-(--color-faint)">Previously</dt>
          <dd class="text-(--color-fg)">Meta · Google / YouTube · Microsoft</dd>
        </div>
        <div>
          <dt class="font-mono text-xs text-(--color-faint)">Focus</dt>
          <dd class="text-(--color-fg)">
            ML, data & recommendation infra at scale
          </dd>
        </div>
        <div>
          <dt class="font-mono text-xs text-(--color-faint)">Education</dt>
          <dd class="text-(--color-fg)">
            MBA, Old Dominion · B.S., Tsinghua University
          </dd>
        </div>
        <div>
          <dt class="font-mono text-xs text-(--color-faint)">Based in</dt>
          <dd class="text-(--color-fg)">Bay Area, California</dd>
        </div>
      </dl>

      <div class="mt-6">
        <a href={`mailto:${SITE.email}`} class="btn-ghost">Get in touch</a>
      </div>
    </div>
  </Section>

  <Section eyebrow="What we value" title="How we work">
    <div class="grid gap-5 sm:grid-cols-3">
      {
        values.map((v) => (
          <div class="card">
            <h3 class="font-semibold">{v.title}</h3>
            <p class="mt-2 text-sm text-(--color-muted)">{v.body}</p>
          </div>
        ))
      }
    </div>
  </Section>
</Layout>
