---
// The works people have published on Kuyun, read from its public catalogue
// when this site is BUILT — so the page is as fresh as the last deploy, and
// deploy.yml rebuilds weekly. Each card links to the work's own page on
// Kuyun, which anyone can read; the live list is always at SITE.kuyunWorks.
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import { COLLECTIONS, SITE, kuyunCollection } from "../consts";

type Work = {
  id: string;
  title: string;
  owner: string;
  type: { name: string; title: string; work: string };
  description: string;
  units_total: number;
  narrated: boolean;
  cover: { title: string; tagline: string; image: string };
};

let works: Work[] = [];
let fetched = true;
try {
  const r = await fetch(SITE.kuyunCatalogue);
  if (!r.ok) throw new Error(`${r.status} from the catalogue`);
  works = (await r.json()) as Work[];
} catch (err) {
  // the page says so rather than failing the whole site's deploy
  fetched = false;
  console.warn("works.astro: the catalogue could not be read:", err);
}

const KINDS: [string, string, string][] = [
  ["lessons", "Courses", "Lesson by lesson, with practice built in and a study partner for every learner."],
  ["book", "Books, read aloud", "Chapters to read or to listen to, with a reading companion that keeps the spoilers."],
  ["paper", "Reports and papers", "A real question, answered from the papers, every claim with its source — then ask the report itself."],
  ["library", "Libraries", "A collection with a purpose and a librarian who answers across all of it."],
  ["briefing", "Briefings", "Looked up afresh every morning and handed over with sources."],
  ["practice", "Practice", "Exercises to work through, checked as you go."],
];
const named = new Set(KINDS.map(([name]) => name));
const byKind = (name: string) =>
  works.filter((w) => w.type.name === name).sort((a, b) => a.title.localeCompare(b.title));
const other = works.filter((w) => !named.has(w.type.name));
const groups = [...KINDS.map(([name, title, lead]) => ({ title, lead, items: byKind(name) })),
  { title: "More", lead: "", items: other }].filter((g) => g.items.length > 0);

const href = (w: Work) => `${SITE.kuyunWorks}/${w.id}`;
const image = (w: Work) => (w.cover?.image ? new URL(w.cover.image, SITE.kuyunUrl).href : "");
const line = (w: Work) => w.cover?.tagline || w.description || "";
const meta = (w: Work) =>
  [w.type.work, w.owner ? `by ${w.owner}` : "", w.units_total ? `${w.units_total} parts` : "", w.narrated ? "read aloud" : ""]
    .filter(Boolean)
    .join(" · ");
const built = new Date().toISOString().slice(0, 10);
const description = `${works.length || "Hundreds of"} works made on Kuyun AI and published by the people who made them: courses with a study partner, books read aloud, reports with their sources, libraries and briefings. Open any of them free.`;
---

<Layout title="Works to try" description={description}>
  <section class="container-x pt-20 pb-6 sm:pt-28">
    <p class="eyebrow mb-5">Published on Kuyun</p>
    <h1 class="max-w-3xl text-4xl font-semibold leading-[1.1] tracking-tight sm:text-5xl">
      Works to try — {works.length ? `${works.length} of them, ` : ""}free every day
    </h1>
    <p class="mt-6 max-w-xl text-lg text-(--color-muted)">
      Everything here was made on Kuyun and published by the person who made it.
      Each comes with a companion of its own: a study partner, a reading
      companion, a report you can question. Open one and it is yours to learn from.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={SITE.kuyunWorks} class="btn-primary">See the live list on Kuyun</a>
      <a href={SITE.kuyunSignup} class="btn-ghost">Try Kuyun free</a>
    </div>
    <nav class="mt-10 flex flex-wrap gap-2" aria-label="Collections on Kuyun">
      {
        COLLECTIONS.map((c) => (
          <a
            href={kuyunCollection(c.page)}
            class="rounded-full border border-(--color-border) bg-(--color-surface) px-3 py-1 text-sm text-(--color-muted) transition-colors hover:border-(--color-accent) hover:text-(--color-accent)"
          >
            {c.label}
          </a>
        ))
      }
    </nav>
  </section>

  {
    !fetched && (
      <Section>
        <p class="text-(--color-muted)">
          The list could not be read when this page was built. Every published work is
          on <a href={SITE.kuyunWorks} class="text-(--color-accent) hover:underline">Kuyun's works page</a>.
        </p>
      </Section>
    )
  }

  {
    groups.map((g) => (
      <Section title={`${g.title} · ${g.items.length}`} lead={g.lead || undefined}>
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {g.items.map((w) => (
            <li>
              <a href={href(w)} class="card block h-full no-underline">
                {image(w) && (
                  <img
                    src={image(w)}
                    alt=""
                    loading="lazy"
                    width="1200"
                    height="800"
                    class="mb-4 aspect-[3/2] w-full rounded-lg bg-(--color-surface-2) object-cover"
                  />
                )}
                <h3 class="font-semibold text-(--color-fg)">{w.title}</h3>
                {line(w) && <p class="mt-2 text-sm text-(--color-muted)">{line(w)}</p>}
                <p class="mt-3 font-mono text-xs text-(--color-faint)">{meta(w)}</p>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    ))
  }

  <Section>
    <p class="text-sm text-(--color-faint)">
      Read from Kuyun's public catalogue on {built}; the site is rebuilt weekly.
      Publish your own work with a cover and it appears here and on Kuyun's
      Explore, and it earns you credit as people use it.
    </p>
  </Section>
</Layout>
