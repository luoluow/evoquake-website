---
interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  id?: string;
}
const { eyebrow, title, lead, id } = Astro.props;
---

<section id={id} class="container-x py-16 sm:py-20">
  {
    (eyebrow || title || lead) && (
      <div class="mb-10 max-w-2xl">
        {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
        {title && (
          <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
            {title}
          </h2>
        )}
        {lead && <p class="mt-3 text-[--color-muted]">{lead}</p>}
      </div>
    )
  }
  <slot />
</section>
