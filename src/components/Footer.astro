---
import { NAV, SITE } from "../consts";
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-[var(--color-border)]">
  <div
    class="container-x flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <a href="/" class="inline-flex" aria-label={`${SITE.name} home`}>
        <img
          src="/evoquake_logo.svg"
          alt={SITE.name}
          width="500"
          height="140"
          class="h-9 w-auto"
        />
      </a>
      <p class="mt-3 max-w-xs text-sm text-[var(--color-faint)]">{SITE.tagline}</p>
    </div>

    <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {NAV.map((i) => <a href={i.href} class="link-muted">{i.label}</a>)}
      <a href={`mailto:${SITE.email}`} class="link-muted">{SITE.email}</a>
    </nav>
  </div>

  <div class="container-x pb-8 text-xs text-[var(--color-faint)]">
    © {year} {SITE.legalName}. All rights reserved.
  </div>
</footer>
